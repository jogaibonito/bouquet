# --- Core services -------------------------------------------------
DATABASE_URL=postgresql://bouquet:bouquet@127.0.0.1:5432/bouquet
TEST_DATABASE_URL=postgresql://bouquet:bouquet@127.0.0.1:5432/bouquet_test
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets -------------------------------------------------------
# 32-byte hex. Generate: openssl rand -hex 32
GUEST_TOKEN_SECRET=
DRIVE_TOKEN_ENC_KEY=

# --- Google (host Drive authorization, NOT host login) -------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# --- Cloudflare R2 (thumbnails, previews, overflow) ----------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bouquet-derived

# --- App -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# fake = in-memory Drive double, used by tests and offline dev
STORAGE_PROVIDER=fake
