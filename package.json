{
  "name": "bouquet",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "services:up": "bash scripts/dev-services.sh up",
    "services:down": "bash scripts/dev-services.sh down",
    "db:migrate": "pnpm --filter @bouquet/db migrate",
    "db:reset": "pnpm --filter @bouquet/db reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/shared packages/db packages/core",
    "lint": "eslint .",
    "db:seed": "tsx scripts/seed.mts",
    "dev": "pnpm --filter @bouquet/web dev",
    "dev:web": "pnpm --filter @bouquet/web dev",
    "dev:mobile": "pnpm --filter @bouquet/mobile dev",
    "smoke": "tsx scripts/smoke.mts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@bouquet/db": "workspace:*",
    "@bouquet/core": "workspace:*",
    "@bouquet/shared": "workspace:*",
    "ioredis": "^5.4.2",
    "drizzle-orm": "^0.38.3",
    "@bouquet/config": "workspace:*",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.19.0"
  }
}
